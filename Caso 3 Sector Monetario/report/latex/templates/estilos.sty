%==================================================
% 2. PALETA DE COLORES CENTRALIZADA (Economic Modern - Light & Legible)
%==================================================

% -- Tema Portada (Fondo claro con textos de alto contraste) --
\definecolor{ThemeBackground}{HTML}{FAF7F5}      % BACKGROUND (Fondo principal crema claro)
\definecolor{ThemeBackgroundLight}{HTML}{FFFFFF} % PANEL (Blanco puro)
\definecolor{ThemeGold}{HTML}{EF4444}            % ACCENT (Rojo intenso para líneas y acentos)
\definecolor{ThemeGoldDark}{HTML}{DC2626}        % NEGATIVE (Rojo más oscuro para sombras o bordes fuertes)
\definecolor{ThemeGoldLight}{HTML}{F87171}       % ROJO SUAVE (Corregido: rojo claro visible sobre blanco, no gris pálido)
\definecolor{ThemeTitle}{HTML}{1F2937}           % TEXT (Gris oscuro casi negro para título principal)
\definecolor{ThemeSubtitle}{HTML}{4B5563}        % GRIS PIZARRA (Corregido: más oscuro para subtítulos legibles)
\definecolor{ThemeText}{HTML}{1F2937}            % TEXT (Gris oscuro para el texto de descripción)
\definecolor{ThemeMuted}{HTML}{64748B}           % TEXT_SOFT (Corregido: gris medio para fechas/marcas que antes no se veían)

% -- Tema Documento Blanco (Interior) --
\definecolor{ReportHeading}{HTML}{1F2937}        % TEXT (Titulares en gris oscuro para un look corporativo)
\definecolor{ReportGold}{HTML}{EF4444}           % ACCENT (Viñetas y pequeños detalles en rojo)
\definecolor{ReportSubtitle}{HTML}{64748B}       % TEXT_SOFT (Gris medio)
\definecolor{ReportText}{HTML}{1F2937}           % TEXT (Color principal de lectura)
\definecolor{ReportLine}{HTML}{EF4444}           % ACCENT (Líneas divisorias rojas)
\definecolor{ReportBox}{HTML}{FAF7F5}            % BACKGROUND (Crema muy claro para la caja ejecutiva)

% -- Elementos Estructurales (Barras y Encabezados) --
\definecolor{SidebarGray}{HTML}{1F2937}          % TEXT (Banda lateral en gris oscuro)
\definecolor{HeaderGray}{HTML}{FAF7F5}           % BACKGROUND (Franja superior en color crema claro)
\definecolor{PageNumberBlack}{HTML}{FFFFFF}      % PANEL (Blanco, para que contraste bien sobre el cuadro rojo)
