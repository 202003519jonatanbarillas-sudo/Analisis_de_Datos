%--------------------------------------------------
% COLORES
%--------------------------------------------------
\definecolor{ThemeBackground}{HTML}{0B0B0B}
\definecolor{ThemeBackgroundLight}{HTML}{0B0B0B}
\definecolor{ThemeGold}{HTML}{D4AF37}
\definecolor{ThemeGoldDark}{HTML}{B58A18}
\definecolor{ThemeTitle}{HTML}{FFD700}
\definecolor{ThemeSubtitle}{HTML}{F5F5F5}
\definecolor{ThemeText}{HTML}{C9C9C9}
\definecolor{ThemeMuted}{HTML}{7C7C7C}
\definecolor{ThemeGoldLight}{HTML}{E6C867}

%==================================================
% PALETA PARA DOCUMENTO BLANCO
%==================================================

\definecolor{ReportHeading}{HTML}{8A6508}
\definecolor{ReportGold}{HTML}{B58A18}
\definecolor{ReportSubtitle}{HTML}{5C5C5C}
\definecolor{ReportText}{HTML}{333333}
\definecolor{ReportLine}{HTML}{D4AF37}
\definecolor{ReportBox}{HTML}{F7F5EF}

%==================================================
% CONFIGURACIÓN DE TEXTO
%==================================================

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.8em}


%==================================================
% TÍTULO PRINCIPAL DEL INFORME
%==================================================

\newcommand{\ReportTitle}[1]{

    \vspace{0.5cm}

    {\Huge\bfseries\color{ReportHeading}#1\par}

    \vspace{0.25cm}

    {\color{ReportLine}
    \rule{8cm}{1.2pt}}

    \vspace{1cm}
}


%==================================================
% TÍTULOS DE SECCIÓN
%==================================================

\newcommand{\SectionTitle}[1]{

    \vspace{0.8cm}

    {\Large\bfseries\color{ReportHeading}#1\par}

    \vspace{0.2cm}

    {\color{ReportLine}
    \rule{\linewidth}{0.5pt}}

    \vspace{0.5cm}
}


%==================================================
% NOTA EJECUTIVA
%==================================================

\newcommand{\ExecutiveNote}[1]{

\begin{tikzpicture}

\node[
fill=ReportBox,
draw=ReportLine,
rounded corners=3pt,
line width=0.6pt,
inner sep=12pt,
text width=.95\linewidth
]
{

{\bfseries\color{ReportHeading}Nota Ejecutiva}

\vspace{0.4cm}

{\color{ReportText}#1}

};

\end{tikzpicture}

\vspace{0.5cm}

}


%==================================================
% METODOLOGÍA (LISTA)
%==================================================

\newcommand{\MethodItem}[1]{

{\color{ReportGold}$\blacktriangleright$}
\hspace{0.5em}
{\color{ReportText}#1}

\vspace{0.25cm}

}

%==================================================
% ÍNDICE EJECUTIVO
%==================================================

\renewcommand{\contentsname}{Contenido}

\renewcommand{\cfttoctitlefont}
{\Huge\bfseries\color{ReportHeading}}

\renewcommand{\cftaftertoctitle}
{
\vspace{0.3cm}

{\color{ReportLine}
\rule{8cm}{1.2pt}}

\vspace{0.8cm}
}


% Secciones
\renewcommand{\cftsecfont}
{\large\bfseries\color{ReportText}}

\renewcommand{\cftsecpagefont}
{\large\color{ReportGold}}


% Subsecciones
\renewcommand{\cftsubsecfont}
{\color{ReportSubtitle}}

\renewcommand{\cftsubsecpagefont}
{\color{ReportGold}}



% Separación
\setlength{\cftbeforesecskip}{8pt}
\setlength{\cftbeforesubsecskip}{4pt}


% Línea punteada
\renewcommand{\cftdotsep}{2}