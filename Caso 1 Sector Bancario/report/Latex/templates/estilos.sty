%==================================================
% COLORES CUERPO DEL INFORME
%==================================================

\definecolor{SidebarGray}{HTML}{2B2B2B}
\definecolor{HeaderGray}{HTML}{E4E4E4}
\definecolor{PageNumberBlack}{HTML}{111111}


%==================================================
% BANDA LATERAL IZQUIERDA
%==================================================

\newlength{\SidebarWidth}

\setlength{\SidebarWidth}{2.5cm}


\AddToShipoutPictureBG{

\begin{tikzpicture}[remember picture,overlay]

% Banda gris oscuro izquierda

\fill[SidebarGray]
(current page.north west)
rectangle
($(current page.south west)+(\SidebarWidth,0)$);


% Línea dorada interior

\fill[ThemeGold]
($(current page.north west)+(\SidebarWidth,0)$)
rectangle
($(current page.south west)+(\SidebarWidth-1.5pt,0)$);


\end{tikzpicture}

}



