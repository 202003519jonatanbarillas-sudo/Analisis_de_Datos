%==================================================
% ESTILOS.STY
% Configuración general del reporte
%==================================================

%==================================================
% CONFIGURACIÓN DE PÁGINA
%==================================================

\RequirePackage[
    a4paper,
    left=2.8cm,
    right=2.8cm,
    top=2.8cm,
    bottom=2.8cm
]{geometry}

%==================================================
% PAQUETES BÁSICOS
%==================================================

% Gráficos
\RequirePackage{graphicx}

% Colores
\RequirePackage{xcolor}

% Hipervínculos
\RequirePackage[hidelinks]{hyperref}

% Referencias inteligentes
\RequirePackage{cleveref}

%==================================================
% TABLAS
%==================================================

\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{adjustbox}

%==================================================
% FIGURAS
%==================================================

\RequirePackage{caption}
\RequirePackage{float}

%==================================================
% LISTAS
%==================================================

\RequirePackage{enumitem}

%==================================================
% ESPACIADO
%==================================================

\RequirePackage{setspace}

%==================================================
% ENCABEZADO Y PIE (KOMA)
%==================================================

\RequirePackage{scrlayer-scrpage}

%==================================================
% COLORES CORPORATIVOS
%==================================================

\definecolor{CorporateBlue}{RGB}{25,55,109}
\definecolor{CorporateGray}{RGB}{90,90,90}
\definecolor{LightGray}{RGB}{235,235,235}

%==================================================
% CONFIGURACIÓN GENERAL
%==================================================

\onehalfspacing

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.7em}

%==================================================
% ENCABEZADO Y PIE
%==================================================

\clearpairofpagestyles

\ihead{\TituloCaso}
\ohead{\SubtituloCaso}

\cfoot{\pagemark}

\pagestyle{scrheadings}

%==================================================
% TÍTULOS (KOMA-Script)
%==================================================

\setkomafont{chapter}{\Huge\bfseries\color{CorporateBlue}}
\setkomafont{section}{\Large\bfseries\color{CorporateBlue}}
\setkomafont{subsection}{\large\bfseries}

%==================================================
% CAPTIONS
%==================================================

\captionsetup{
    labelfont=bf,
    font=small,
    justification=centering
}

%==================================================
% LISTAS
%==================================================

\setlist[itemize]{
    itemsep=0.3em,
    topsep=0.5em
}

\setlist[enumerate]{
    itemsep=0.3em,
    topsep=0.5em
}

%==================================================
% HIPERVÍNCULOS
%==================================================

\hypersetup{
    colorlinks=true,
    linkcolor=CorporateBlue,
    citecolor=CorporateBlue,
    urlcolor=CorporateBlue
}