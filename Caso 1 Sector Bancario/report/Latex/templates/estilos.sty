%==================================================
% CONFIGURACIÓN DE PÁGINA
%==================================================

\RequirePackage[
    a4paper,
    left=2.8cm,
    right=2.8cm,
    top=2.8cm,
    bottom=2.8cm
]{geometry}

%==================================================
% PAQUETES
%==================================================

% Imágenes
\RequirePackage{graphicx}

% Colores
\RequirePackage{xcolor}

% Tablas
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}

% Figuras
\RequirePackage{caption}

% Hipervínculos
\RequirePackage[hidelinks]{hyperref}

% Espaciado
\RequirePackage{setspace}

% Listas
\RequirePackage{enumitem}

% Referencias cruzadas
\RequirePackage{cleveref}

% Personalización de títulos
\RequirePackage{titlesec}

% Encabezado y pie (KOMA-Script)
\RequirePackage{scrlayer-scrpage}

%==================================================
% COLORES CORPORATIVOS
%==================================================

\definecolor{CorporateBlue}{RGB}{25,55,109}
\definecolor{CorporateGray}{RGB}{90,90,90}
\definecolor{LightGray}{RGB}{230,230,230}

%==================================================
% ESPACIADO DEL DOCUMENTO
%==================================================

\onehalfspacing

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.7em}

%==================================================
% ENCABEZADO Y PIE
%==================================================

\clearpairofpagestyles

\ihead{\TituloCaso}
\ohead{\SubtituloCaso}

\cfoot{\pagemark}

\pagestyle{scrheadings}

%==================================================
% TÍTULOS
%==================================================

\setkomafont{chapter}{\Huge\bfseries\color{CorporateBlue}}
\setkomafont{section}{\Large\bfseries\color{CorporateBlue}}
\setkomafont{subsection}{\large\bfseries}

%==================================================
% FIGURAS
%==================================================

\captionsetup{
    labelfont=bf,
    font=small,
    justification=centering
}