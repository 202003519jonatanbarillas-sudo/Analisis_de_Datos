%==================================================
% 2. PALETA DE COLORES CENTRALIZADA (Midnight Blue)
%==================================================

% -- Tema Dark Blue (Portada) --
\definecolor{ThemeBackground}{HTML}{0B1220}      % BACKGROUND
\definecolor{ThemeBackgroundLight}{HTML}{111827} % PANEL
\definecolor{ThemeGold}{HTML}{3B82F6}            % ACCENT (Reemplaza al dorado)
\definecolor{ThemeGoldDark}{HTML}{1E293B}        % CARD
\definecolor{ThemeGoldLight}{HTML}{94A3B8}       % TEXT_SOFT
\definecolor{ThemeTitle}{HTML}{E5E7EB}           % TEXT
\definecolor{ThemeSubtitle}{HTML}{94A3B8}        % TEXT_SOFT
\definecolor{ThemeText}{HTML}{E5E7EB}            % TEXT
\definecolor{ThemeMuted}{HTML}{64748B}           % NEUTRAL

% -- Tema Documento Blanco (Interior) --
\definecolor{ReportHeading}{HTML}{3B82F6}        % ACCENT (Titulares en azul)
\definecolor{ReportGold}{HTML}{3B82F6}           % ACCENT (Viñetas y detalles)
\definecolor{ReportSubtitle}{HTML}{64748B}       % NEUTRAL
\definecolor{ReportText}{HTML}{0B1220}           % BACKGROUND (Texto oscuro para contraste en fondo blanco)
\definecolor{ReportLine}{HTML}{3B82F6}           % ACCENT (Líneas divisorias)
\definecolor{ReportBox}{HTML}{E5E7EB}            % TEXT (Gris muy claro para la caja ejecutiva)

% -- Elementos Estructurales (Barras y Encabezados) --
\definecolor{SidebarGray}{HTML}{111827}          % PANEL (Banda lateral oscura)
\definecolor{HeaderGray}{HTML}{E5E7EB}           % TEXT (Franja superior gris claro)
\definecolor{PageNumberBlack}{HTML}{0B1220}      % BACKGROUND (Número de página oscuro)

