%==================================================
% 4. TIPOGRAFÍA Y ESPACIADO GENERAL
%==================================================

\setmainfont{Arial}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.8em}
\setstretch{1.15}

%==================================================
% 5. COMANDOS PERSONALIZADOS
%==================================================

% -- Título Principal de Sección --
\newcommand{\ReportTitle}[1]{
    \vspace{0.5cm}
    {\Huge \bfseries \color{ReportHeading} #1 \par}
    \vspace{0.25cm}
    {\color{ReportLine} \rule{8cm}{1.2pt}}
    \vspace{1cm}
}

% -- Título de Subsección --
\newcommand{\SectionTitle}[1]{
    \vspace{0.8cm}
    {\Large \bfseries \color{ReportHeading} #1 \par}
    \vspace{0.2cm}
    {\color{ReportLine} \rule{\linewidth}{0.5pt}}
    \vspace{0.5cm}
}

% -- Caja Ejecutiva --
\newcommand{\ExecutiveNote}[1]{
    \begin{tikzpicture}
    \node[
        fill=ReportBox,
        draw=ReportLine,
        rounded corners=3pt,
        line width=.6pt,
        inner sep=12pt,
        text width=.95\linewidth
    ]
    {
        {\bfseries \color{ReportHeading} Nota Ejecutiva}
        \vspace{0.3cm}
        {\color{ReportText} \par #1}
    };
    \end{tikzpicture}
    \vspace{0.5cm}
}

% -- Lista Metodológica --
\newcommand{\MethodItem}[1]{
    {\color{ReportGold} $\blacktriangleright$}
    \hspace{0.5em}
    {\color{ReportText} #1}
    \vspace{0.25cm}
}

%==================================================
% 6. CONFIGURACIÓN DEL ÍNDICE (TOC)
%==================================================

\renewcommand{\contentsname}{Contenido}

% Título del índice
\renewcommand{\cfttoctitlefont}{\Huge \bfseries \color{ReportHeading}}
\renewcommand{\cftaftertoctitle}{
    \vspace{0.3cm}
    {\color{ReportLine} \rule{8cm}{1.2pt}}
    \vspace{0.8cm}
}

% Capítulos en el índice
\renewcommand{\cftchapfont}{\large \bfseries \color{ReportText}}
\renewcommand{\cftchappagefont}{\large \color{ReportGold}}
\setlength{\cftbeforechapskip}{10pt}

% Secciones en el índice
\renewcommand{\cftsecfont}{\large \bfseries \color{ReportText}}
\renewcommand{\cftsecpagefont}{\large \color{ReportGold}}
\renewcommand{\cftdotsep}{2}
\setlength{\cftbeforesecskip}{8pt}

%==================================================
% 7. ELEMENTOS DE FONDO Y ENCABEZADOS (LAYOUT)
%==================================================

\newlength{\SidebarWidth}
\setlength{\SidebarWidth}{2.5cm}

% -- Banda Lateral y Encabezado Ejecutivo (Fondo) --
\AddToShipoutPictureBG{
    \begin{tikzpicture}[remember picture,overlay]
        % 1. Banda lateral gris oscuro izquierda
        \fill[SidebarGray] (current page.north west) rectangle ($(current page.south west)+(\SidebarWidth,0)$);

        % 2. Línea dorada interior (Banda lateral)
        \fill[ThemeGold] ($(current page.north west)+(\SidebarWidth,0)$) rectangle ($(current page.south west)+(\SidebarWidth-1.5pt,0)$);

        % 3. Franja superior gris (Encabezado)
        \fill[HeaderGray] (current page.north west) rectangle ($(current page.north east)+(0,-2.5cm)$);

        % 4. Línea dorada inferior (Encabezado)
        \fill[ThemeGold] ($(current page.north west)+(0,-2.5cm)$) rectangle ($(current page.north east)+(0,-2.55cm)$);

        % 5. Esquina dorada superior izquierda
        \fill[ThemeGold] (current page.north west) rectangle ($(current page.north west)+(3cm,-3cm)$);

        % 6. Texto Encabezado Izquierda (Asume que \TituloCaso está definido en el documento principal)
        \node[anchor=west, font=\bfseries\large, text=ReportHeading] 
            at ($(current page.north west)+(3.5cm,-1.5cm)$) {\TituloCaso};

        % 7. Texto Encabezado Derecha (Asume que \SubtituloSector está definido en el documento principal)
        \node[anchor=east, font=\large, text=ReportSubtitle] 
            at ($(current page.north east)+(-1cm,-1.5cm)$) {\SubtituloSector};
    \end{tikzpicture}
}

% -- Número de Página (Primer plano) --
\AddToShipoutPictureFG{
    \ifPortada
        % No dibujar número de página si es portada
    \else
        \begin{tikzpicture}[remember picture,overlay]
            \node[
                anchor=south east,
                fill=ThemeGold,
                minimum width=1.75cm,
                minimum height=1.75cm,
                text=PageNumberBlack,
                font=\fontsize{25}{20}\selectfont\bfseries
            ]
            at ($(current page.south east)+(-0.2cm,0.2cm)$)
            {\thepage};
        \end{tikzpicture}
    \fi
}

